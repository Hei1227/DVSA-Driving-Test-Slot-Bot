# Copy this file to .env and fill in your values.
# .env is listed in .gitignore and will never be committed.

# Discord webhook URL for booking notifications (optional).
# Create one at: Server Settings → Integrations → Webhooks
DISCORD_WEBHOOK=https://discord.com/api/webhooks/...

# Your DVSA driving licence number — auto-filled on the Licence details page.
# Example format: MORGA753116SM9IJ
# You can also set this directly in config.py if you prefer.
DRIVING_LICENCE_NUMBER=

# Chrome profile folder (optional). Created automatically on first run.
# Defaults to C:\chrome-profile on Windows, ~/chrome-profile on macOS/Linux.
# PROFILE_PATH=
